{
	"name": "shoptrack",
	"version": "1.0.5",
	"description": "",
	"main": "main.js",
	"scripts": {
		"test": "node --test tests/*.test.js",
		"test:package": "node --test --test-timeout=600000 tests/package/*.test.js",
		"start": "electron .",
		"build:css": "npx @tailwindcss/cli -i ./assets/css/styles.css -o ./dist/output.css",
		"watch:css": "npx @tailwindcss/cli -i ./assets/css/styles.css -o ./dist/output.css --watch",
		"dev": "npm run watch:css",
		"prebuild": "npm run build:css",
		"build": "electron-builder"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@tailwindcss/cli": "^4.1.17",
		"electron": "^39.2.1",
		"electron-builder": "^26.4.0",
		"standard": "^17.1.2",
		"tailwindcss": "^4.1.17"
	},
	"eslintConfig": {
		"extends": "standard"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.1.0",
		"echarts": "^6.0.0",
		"electron-log": "^5.4.3",
		"electron-updater": "^6.7.3",
		"pdfkit": "^0.17.2",
		"pdfkit-table": "^0.1.99",
		"sqlite3": "^5.1.7"
	},
	"build": {
		"directories": {
			"output": "release"
		},
		"files": [
			"**/*",
			"!data/**",
			"!tests/**",
			"!portable.txt",
			"!README.md",
			"!tailwind.config.js",
			"!backend/services/test-pdf.js",
			"!backend/services/PATH_SERVICE_README.md"
		],
		"win": {
			"target": "nsis"
		},
		"nsis": {
			"deleteAppDataOnUninstall": false,
			"artifactName": "${productName}-Setup-${version}.${ext}"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "Chris0171",
				"repo": "ShopTrack"
			}
		]
	}
}
